# Anki Syncserver Environment Variables
# This file is automatically loaded by Portainer when using stack.env as env_file

# Docker image to use
# Examples:
#   ghcr.io/YOUR_USERNAME/anki-syncserver:edge
#   ghcr.io/YOUR_USERNAME/anki-syncserver:25.09.2-standard
#   ghcr.io/YOUR_USERNAME/anki-syncserver:25-distroless
IMAGE_NAME=ghcr.io/senz/anki-syncserver:edge
MAX_SYNC_PAYLOAD_MEGS=1024

# PASSWORDS_HASHED=1

# Additional environment variables can be added here
# See: https://docs.ankiweb.net/sync-server.html
# Note: SYNC_BASE and SYNC_PORT are ignored (SYNC_BASE for safety, SYNC_PORT for simplicity)
